# Algorand API Configuration
# Replace with your actual API token
VITE_ALGORAND_API_TOKEN=your_api_token_here

# Algorand API Server
# Options:
# - https://testnet-api.algonode.cloud (Testnet)
# - https://mainnet-api.algonode.cloud (Mainnet)
# - http://localhost:4001 (Local)
VITE_ALGORAND_SERVER=https://testnet-api.algonode.cloud

# Algorand API Port (optional)
VITE_ALGORAND_PORT= 